# ─── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── MongoDB ────────────────────────────────────────────────────────────
# Use a MongoDB Atlas connection string for production
# Example: mongodb+srv://user:password@cluster.mongodb.net/qwilopro?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qwilopro?retryWrites=true&w=majority

# ─── JWT & Session ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_64_CHARS
JWT_EXPIRY=15m
JWT_EXPIRY_REFRESH=30d
COOKIE_EXPIRY=300000
COOKIE_EXPIRY_REFRESH=2592000000
PASSWORD_SALT=10

# ─── Domain & Cookies ───────────────────────────────────────────────────
# Set to your Vercel deployment URL (e.g. https://qwilopro.vercel.app)
FRONTEND_DOMAIN=https://your-app.vercel.app
# For Vercel, cookies must be set on the root domain
FRONTEND_DOMAIN_COOKIE=.vercel.app

# ─── Public Next.js Variables (exposed to browser) ──────────────────────
NEXT_PUBLIC_BACKEND_URL=/api/v1
# Leave empty or set to Pusher — Socket.IO is NOT used on Vercel
NEXT_PUBLIC_SOCKET_IO=

# ─── Pusher (Real-Time) ─────────────────────────────────────────────────
# Sign up free at https://pusher.com → Create App → Channels
# Copy credentials from App Keys section
PUSHER_APP_ID=your_pusher_app_id
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# ─── Paystack (PRIMARY Payment Gateway) ─────────────────────────────────
# Sign up at https://paystack.com → Settings → API Keys & Webhooks
# Primary payment gateway — NGN (Nigerian Naira) is the default currency
PAYSTACK_SECRET_KEY=sk_live_XXXX
PAYSTACK_PUBLIC_KEY=pk_live_XXXX
# Webhook URL: https://your-app.vercel.app/api/v1/auth/paystack-webhook

# ─── Stripe (OPTIONAL Payment Gateway) ──────────────────────────────────
# Only required if you enable Stripe as a secondary payment option
# Sign up at https://stripe.com → Developers → API Keys
STRIPE_SECRET=sk_live_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX
STRIPE_PORTAL_CONFIG_ID=bpc_XXXX
# Webhook URL: https://your-app.vercel.app/api/v1/auth/stripe-webhook

# ─── Email / SMTP ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your@email.com
SMTP_PASSWORD=your_app_password

# ─── Encryption ─────────────────────────────────────────────────────────
# Generate a 32-char random key:  openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_KEY
# Generate a 64-char hex key:     openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX_KEY

# ─── WhatsApp Gateway (Nectar / Baileys) ─────────────────────────────────
# Hosted Baileys WhatsApp Web proxy (Render service)
WHATSAPP_GATEWAY_URL=https://your-nectar-service.onrender.com
# API Secret configured on Render for the nectar service (KEEP SECRET - do not commit actual key)
WHATSAPP_API_SECRET=your_whatsapp_api_secret_here
# Tenant / session identifier for your business (e.g. default)
WHATSAPP_SESSION_ID=default


